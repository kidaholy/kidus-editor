[TEMPLATE]
# --- Server ---
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---
# Leave blank to auto-start an in-memory MongoDB (dev mode).
MONGODB_URI=
MONGO_DB_NAME=video_portfolio
# Optional: comma-separated DNS resolvers used for mongodb+srv SRV lookups.
# Only needed if Node's default resolver is broken (e.g. reports 127.0.0.1).
DNS_SERVERS=

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@portfolio.dev
ADMIN_PASSWORD=ChangeMe123!

# --- Storage: local (default) or Cloudinary ---
STORAGE=local
CLOUDINARY_URL=
CLOUDINARY_FOLDER=portfolio/cv

# --- Contact / Email (Nodemailer). Leave blank to only store messages. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=hello@yourdomain.com

# --- Seeding ---
SEED_ON_START=true
